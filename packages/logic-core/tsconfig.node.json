{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "lib": [
      "ES2021"
    ],
    "target": "ES2021",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": [
    "scripts"
  ],
  "exclude": [
    "scripts/temp",
    "**/*.global.d.ts"
  ]
}