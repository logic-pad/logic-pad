{
  "name": "@logic-pad/core",
  "version": "0.28.0",
  "type": "module",
  "files": [
    "dist",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/logic-pad/logic-pad",
  "repository": {
    "type": "git",
    "url": "https://github.com/logic-pad/logic-pad.git"
  },
  "keywords": [
    "logic",
    "puzzle",
    "game",
    "solver",
    "logic-pad",
    "grid"
  ],
  "license": "AGPL-3.0-only",
  "module": "./dist/src/index.js",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./data/*": {
      "import": "./dist/src/data/*",
      "require": "./dist/src/data/*"
    },
    "./polyfill/*": {
      "import": "./dist/src/polyfill/*",
      "require": "./dist/src/polyfill/*"
    },
    "./assets/*": {
      "import": "./assets/*",
      "require": "./assets/*"
    },
    "./locale/*": {
      "import": "./dist/src/locale/*.js",
      "require": "./dist/src/locale/*.js"
    }
  },
  "scripts": {
    "build": "rimraf dist/ && bun run codegen && bunx --bun tsc -p tsconfig.json && bun run typegen",
    "typecheck": "bunx --bun tsc -p tsconfig.json --noEmit",
    "codegen": "bun ./scripts/genImports.ts && bun ./scripts/genEntry.ts",
    "typegen": "bun ./scripts/genTypes.ts",
    "bench:prepare": "bun ./benchmark/prepareBench.ts",
    "bench:run": "bun ./benchmark/runBench.ts",
    "bench:prepare:lp": "bun bench:prepare universal -f all_puzzles_logic_pad.json -n lp",
    "bench:run:lp": "bun bench:run universal universal_dev -n lp",
    "insight-eval": "bun ./benchmark/insightEval.ts",
    "locales:extract": "bun x --bun lingui extract --config lingui.config.ts",
    "locales:compile": "bun x --bun lingui compile --config lingui.config.ts --typescript",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=23.11.0"
  },
  "dependencies": {
    "@lingui/core": "^6.10.0",
    "@logic-pad/cspuz-solver": "^0.2.1",
    "compression-streams-polyfill": "^0.1.7",
    "event-iterator": "^2.0.0",
    "lodash": "^4.17.21",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@lingui/cli": "^6.10.0",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/bun": "^1.2.20",
    "@types/glob": "^9.0.0",
    "@types/lodash": "^4.17.20",
    "fast-glob": "^3.3.3",
    "p-queue": "^9.0.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "uint8-to-base64": "^0.2.1"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}